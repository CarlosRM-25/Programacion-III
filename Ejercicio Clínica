using System;
using System.Collections.Generic;
using System.Linq;

class Paciente
{
    public int Id { get; set; }
    public string Nombre { get; set; }
    public int Edad { get; set; }
    public string Motivo { get; set; }
    public int Prioridad { get; set; }
}

class ProgramaClinica
{
    static List<Paciente> cola = new List<Paciente>();
    static List<Paciente> atendidos = new List<Paciente>();
    static int contador = 1;

    static void Main()
    {
        while (true)
        {
            Console.WriteLine("\n=== CLÍNICA SALUDPLUS ===");
            Console.WriteLine("1. Registrar paciente");
            Console.WriteLine("2. Listar cola");
            Console.WriteLine("3. Atender siguiente");
            Console.WriteLine("4. Resumen");
            Console.WriteLine("5. Salir");
            Console.Write("Seleccione una opción: ");
            string opcion = Console.ReadLine();

            switch (opcion)
            {
                case "1": Registrar(); break;
                case "2": ListarCola(); break;
                case "3": Atender(); break;
                case "4": Resumen(); break;
                case "5": return;
                default: Console.WriteLine("Opción inválida."); break;
            }
        }
    }

    static void Registrar()
    {
        Console.Write("Nombre: ");
        string nombre = Console.ReadLine()?.Trim();
        if (string.IsNullOrEmpty(nombre)) { Console.WriteLine("Nombre no puede estar vacío."); return; }

        Console.Write("Edad: ");
        if (!int.TryParse(Console.ReadLine(), out int edad) || edad <= 0)
        {
            Console.WriteLine("Edad inválida.");
            return;
        }

        Console.Write("Motivo: ");
        string motivo = Console.ReadLine()?.Trim();
        if (string.IsNullOrEmpty(motivo)) { Console.WriteLine("Motivo no puede estar vacío."); return; }

        Console.Write("Prioridad (1-3): ");
        if (!int.TryParse(Console.ReadLine(), out int prioridad) || prioridad < 1 || prioridad > 3)
        {
            Console.WriteLine("Prioridad inválida.");
            return;
        }

        cola.Add(new Paciente
        {
            Id = contador++,
            Nombre = nombre,
            Edad = edad,
            Motivo = motivo,
            Prioridad = prioridad
        });

        Console.WriteLine($"Paciente {nombre} registrado con prioridad {prioridad}.");
    }

    static void ListarCola()
    {
        if (cola.Count == 0)
        {
            Console.WriteLine("No hay pacientes en la cola.");
            return;
        }

        var ordenados = cola.OrderBy(p => p.Prioridad).ThenBy(p => p.Id);
        Console.WriteLine("\nID – Nombre (Prioridad)");
        foreach (var p in ordenados)
            Console.WriteLine($"{p.Id} – {p.Nombre} (P{p.Prioridad})");
    }

    static void Atender()
    {
        if (cola.Count == 0)
        {
            Console.WriteLine("No hay pacientes en cola.");
            return;
        }

        var siguiente = cola.OrderBy(p => p.Prioridad).ThenBy(p => p.Id).First();
        cola.Remove(siguiente);
        atendidos.Add(siguiente);

        Console.WriteLine($"Atendido: {siguiente.Nombre} (P{siguiente.Prioridad})");
    }

    static void Resumen()
    {
        int total = atendidos.Count;
        int p1 = atendidos.Count(p => p.Prioridad == 1);
        int p2 = atendidos.Count(p => p.Prioridad == 2);
        int p3 = atendidos.Count(p => p.Prioridad == 3);

        Console.WriteLine($"Total: {total} | P1: {p1}, P2: {p2}, P3: {p3}");
    }
}
